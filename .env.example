# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore - nie trafia do repo.

# SEC wymaga identyfikacji (imię, nazwisko, e-mail). Bez tego: brak insiderów i 13F,
# reszta (notowania, strona, alerty, skan rynku) działa.
SEC_USER_AGENT="Imie Nazwisko twoj@email.com"

# Quiver Quantitative - transakcje Kongresu. Puste = Kongres pominięty.
QUIVER_API_KEY=

# Discord: ustawienia kanału -> Integracje -> Webhooki -> Nowy webhook -> kopiuj URL.
DISCORD_WEBHOOK_URL=

# Hosting rafmall.ch - do scripts/publish.py (wgrywa out/site/roboty.html przez FTP).
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_DIR=/public_html
FTP_TLS=1
